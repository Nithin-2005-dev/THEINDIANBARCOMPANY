generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  OPS
  FINANCE
  CLIENT
  VENDOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ARCHIVED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  PREPARATION
  EXECUTION
  COMPLETED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  MID
  FINAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProjectStage {
  PLANNING
  PREPARATION
  READY
  EVENT_DAY
  COMPLETED
}

enum MessageType {
  USER
  SYSTEM
}

enum ConversationThreadType {
  GROUP
  DIRECT_ADMIN
  DIRECT_STAFF
  DIRECT_VENDOR
}

enum NotificationType {
  PROPOSAL
  PAYMENT
  STATUS
  MESSAGE
  EVENT
  CONTRACT
  GENERAL
}

enum AuditAction {
  OTP_SENT
  OTP_VERIFIED
  OTP_FAILED
  LOGIN
  REFRESH_TOKEN_ISSUED
  REFRESH_TOKEN_REVOKED
  LOGOUT
  SESSION_REVOKED
  SUSPICIOUS_ACTIVITY_DETECTED
  LEAD_CREATED
  LEAD_UPDATED
  PROPOSAL_CREATED
  PROPOSAL_DECIDED
  CONTRACT_SIGNED
  PAYMENT_ORDER_CREATED
  PAYMENT_CAPTURED
  PAYMENT_WEBHOOK_PROCESSED
  VENDOR_ASSIGNED
  FILE_UPLOADED
  LEAD_NOTE_CREATED
  LEAD_NOTE_UPDATED
  LEAD_NOTE_DELETED
  LEAD_STATUS_CHANGED
  LEAD_MANUAL_ACTIVITY
  LEAD_ASSIGNED
  PROJECT_ASSIGNED
  PROJECT_UPDATED
  USER_CREATED
  USER_ROLE_UPDATED
  USER_STATUS_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMMENT_ADDED
  PROJECT_DOCUMENT_UPLOADED
  ADMIN_BOOTSTRAPPED
}

enum LeadActivityType {
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  PROPOSAL_CREATED
  CONTRACT_CREATED
  PAYMENT_CREATED
  PAYMENT_UPDATED
  MANUAL_ACTION
  OWNER_ASSIGNED
  SUPPORTING_STAFF_ASSIGNED
}

enum AssignmentRole {
  PRIMARY
  SUPPORTING
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPICIOUS
}

enum OtpChallengeStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  LOCKED
  CONSUMED
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum ProjectTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum TeamCategory {
  CORE
  TRUSTEE
  INFLUENCERS
}

enum AiMessageActor {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                    String     @id @default(uuid())
  phone                 String?    @unique
  email                 String?    @unique
  name                  String?
  role                  Role       @default(CLIENT)
  isActive              Boolean    @default(true)
  lastLoginAt           DateTime?
  deletedAt             DateTime?
  leads                 Lead[]
  projects              Project[]  @relation("ClientProjects")
  auditLogs             AuditLog[]
  sessions              Session[]
  otpChallenges         OtpChallenge[]
  idempotencyKeys       IdempotencyKey[]
  notifications         Notification[]
  messages              Message[]
  projectUpdates        ProjectUpdate[]
  authoredLeadNotes     LeadInternalNote[] @relation("LeadNoteAuthor")
  leadActivities        LeadActivity[]
  leadStatusChanges     LeadStatusHistory[]
  leadAssignmentsCreated LeadAssignment[]   @relation("LeadAssignmentCreatedBy")
  leadAssignmentsUpdated LeadAssignment[]   @relation("LeadAssignmentUpdatedBy")
  projectAssignmentsCreated ProjectAssignment[] @relation("ProjectAssignmentCreatedBy")
  projectAssignmentsUpdated ProjectAssignment[] @relation("ProjectAssignmentUpdatedBy")
  assignedLeads         LeadAssignment[]    @relation("AssignedLeadUser")
  assignedProjects      ProjectAssignment[] @relation("AssignedProjectUser")
  assignedProjectTasks  ProjectTask[]       @relation("AssignedProjectTaskUser")
  createdProjectTasks   ProjectTask[]       @relation("CreatedProjectTaskUser")
  projectTaskComments   ProjectTaskComment[] @relation("ProjectTaskCommentAuthor")
  uploadedTaskAttachments ProjectTaskAttachment[] @relation("ProjectTaskAttachmentUploader")
  taskActivities        ProjectTaskActivity[] @relation("ProjectTaskActivityActor")
  uploadedProjectDocuments ProjectDocument[] @relation("ProjectDocumentUploader")
  vendorProfile         Vendor?
  aiConversations       AiConversation[]
  assistantEvents       AiAssistantEvent[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([deletedAt])
}

model Lead {
  id         String     @id @default(uuid())
  eventType  String
  location   String
  city       String?
  packageName String?
  packageLabel String?
  addOns     String[]
  eventDate  DateTime
  guestCount Int?
  budgetMin  Int?
  budgetMax  Int?
  notes      String?
  status     LeadStatus @default(NEW)
  clientId   String
  client     User       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposals  Proposal[]
  threads    ConversationThread[]
  internalNotes LeadInternalNote[]
  activities LeadActivity[]
  statusHistory LeadStatusHistory[]
  assignments LeadAssignment[]
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([eventDate])
  @@index([location])
  @@index([budgetMin, budgetMax])
}

model Proposal {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  price        Int
  scope        String
  deliverables String
  timeline     String
  notes        String?
  documentUrl  String?
  clientComment String?
  decidedAt    DateTime?
  status       ProposalStatus @default(DRAFT)
  contract     Contract?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([deletedAt])
  @@index([leadId])
  @@index([status])
}

model Contract {
  id          String         @id @default(uuid())
  proposalId  String         @unique
  proposal    Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  documentUrl String
  status      ContractStatus @default(DRAFT)
  signedAt    DateTime?
  signedByName String?
  acceptedTermsAt DateTime?
  project     Project?
  versions    ContractDocumentVersion[]
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([deletedAt])
}

model Project {
  id         String          @id @default(uuid())
  contractId String          @unique
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  clientId   String
  client     User            @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  status     ProjectStatus   @default(PLANNING)
  progress   Int             @default(0)
  summary    String?
  payments   Payment[]
  vendors    ProjectVendor[]
  updates    ProjectUpdate[]
  assignments ProjectAssignment[]
  tasks      ProjectTask[]
  documents  ProjectDocument[]
  feedback   EventFeedback?
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
  @@index([progress])
}

model Vendor {
  id          String          @id @default(uuid())
  name        String
  serviceType String
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone       String?
  email       String?
  pricingInfo String?
  isAvailable Boolean         @default(true)
  notes       String?
  assignments ProjectVendor[]
  tasks       ProjectTask[]
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([deletedAt])
  @@index([serviceType])
}

model TeamMember {
  id           String       @id @default(uuid())
  name         String
  designation  String
  category     TeamCategory
  bio          String?
  photoUrl     String?
  photoPublicId String?
  instagramUrl String?
  linkedInUrl  String?
  websiteUrl   String?
  email        String?
  isActive     Boolean      @default(true)
  isVisible    Boolean      @default(true)
  sortOrder    Int          @default(0)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([deletedAt])
  @@index([category, sortOrder])
  @@index([isActive, isVisible])
}

model ProjectVendor {
  id         String   @id @default(uuid())
  projectId  String
  vendorId   String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([projectId, vendorId])
  @@index([vendorId])
}

model Payment {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           PaymentType
  status         PaymentStatus @default(PENDING)
  amount         Int
  dueDate        DateTime?
  currency       String        @default("INR")
  gateway        String        @default("RAZORPAY")
  gatewayOrderId String?
  transactionId  String?
  gatewaySignature String?
  gatewayMetadata Json?
  receiptUrl      String?
  webhookEventId  String?      @unique
  paidAt         DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([deletedAt])
  @@index([projectId])
  @@index([status])
}

model LeadInternalNote {
  id         String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content     String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

model LeadActivity {
  id          String           @id @default(uuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type         LeadActivityType
  actorId      String?
  actor        User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  description  String
  metadata     Json?
  createdAt    DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([actorId])
  @@index([type])
}

model LeadStatusHistory {
  id          String     @id @default(uuid())
  leadId       String
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus    LeadStatus?
  newStatus    LeadStatus
  changedById  String?
  changedBy    User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([changedById])
}

model LeadAssignment {
  id           String         @id @default(uuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation("AssignedLeadUser", fields: [userId], references: [id], onDelete: Restrict)
  role          AssignmentRole
  isActive      Boolean        @default(true)
  assignedById  String?
  assignedBy    User?          @relation("LeadAssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  endedById     String?
  endedBy       User?          @relation("LeadAssignmentUpdatedBy", fields: [endedById], references: [id], onDelete: SetNull)
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  notes         String?

  @@index([leadId, isActive])
  @@index([userId, isActive])
  @@index([role, isActive])
}

model ProjectAssignment {
  id           String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation("AssignedProjectUser", fields: [userId], references: [id], onDelete: Restrict)
  role          AssignmentRole
  isActive      Boolean        @default(true)
  assignedById  String?
  assignedBy    User?          @relation("ProjectAssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  endedById     String?
  endedBy       User?          @relation("ProjectAssignmentUpdatedBy", fields: [endedById], references: [id], onDelete: SetNull)
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  notes         String?

  @@index([projectId, isActive])
  @@index([userId, isActive])
  @@index([role, isActive])
}

model ConversationThread {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       ConversationThreadType @default(GROUP)
  messages   Message[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([leadId, type])
  @@index([leadId, type])
}

model Message {
  id             String             @id @default(uuid())
  threadId       String
  thread         ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           MessageType        @default(USER)
  body           String
  attachmentName String?
  attachmentKey  String?
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model ProjectUpdate {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       ProjectStage
  title       String
  body        String?
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isInternal  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([stage])
}

model ProjectTask {
  id               String              @id @default(uuid())
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           ProjectTaskStatus   @default(PENDING)
  priority         ProjectTaskPriority @default(MEDIUM)
  dueDate          DateTime?
  completedAt      DateTime?
  blockedReason    String?
  dependencyIds    String[]
  checklist        Json?
  assignedUserId   String?
  assignedUser     User?               @relation("AssignedProjectTaskUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedVendorId String?
  assignedVendor   Vendor?             @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?               @relation("CreatedProjectTaskUser", fields: [createdById], references: [id], onDelete: SetNull)
  attachments      ProjectTaskAttachment[]
  comments         ProjectTaskComment[]
  activities       ProjectTaskActivity[]
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([projectId, status])
  @@index([assignedUserId, status])
  @@index([assignedVendorId, status])
  @@index([dueDate])
  @@index([deletedAt])
}

model ProjectTaskAttachment {
  id           String      @id @default(uuid())
  taskId        String
  task          ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  fileUrl      String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?       @relation("ProjectTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([taskId, createdAt])
  @@index([uploadedById])
}

model ProjectTaskComment {
  id         String      @id @default(uuid())
  taskId      String
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?       @relation("ProjectTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
}

model ProjectTaskActivity {
  id          String      @id @default(uuid())
  taskId       String
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?       @relation("ProjectTaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type         String
  description  String
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
  @@index([type])
}

model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  fileUrl      String
  contentType  String
  sizeBytes    Int
  category     String   @default("GENERAL")
  uploadedById String?
  uploadedBy   User?    @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([uploadedById])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  actionUrl  String?
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}

model EventFeedback {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rating           Int
  testimonial      String?
  comments         String?
  allowMediaUsage  Boolean  @default(false)
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContractDocumentVersion {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fileKey     String
  version     Int
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@unique([contractId, version])
  @@index([contractId])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String
  entityId    String?
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Session {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash     String        @unique
  status               SessionStatus @default(ACTIVE)
  deviceFingerprint    String?
  userAgent            String?
  initialIpAddress     String?
  lastIpAddress        String?
  lastSeenAt           DateTime?
  expiresAt            DateTime
  revokedAt            DateTime?
  suspiciousActivityAt DateTime?
  suspiciousReason     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model OtpChallenge {
  id                 String             @id @default(uuid())
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifier         String
  channel            OtpChannel
  phone              String?
  email              String?
  otpCodeHash        String
  status             OtpChallengeStatus @default(PENDING)
  expiresAt          DateTime
  consumedAt         DateTime?
  attempts           Int                @default(0)
  maxAttempts        Int                @default(5)
  cooldownUntil      DateTime?
  requestIpAddress   String?
  verifyIpAddress    String?
  abuseDetectedAt    DateTime?
  abuseReason        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([identifier, status, createdAt])
  @@index([expiresAt])
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  key          String
  scope        String
  requestHash  String
  status       IdempotencyStatus @default(PROCESSING)
  responseCode Int?
  responseBody Json?
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  expiresAt    DateTime
  updatedAt    DateTime          @updatedAt

  @@unique([key, scope])
  @@index([userId, scope])
  @@index([expiresAt])
}

model AiConversation {
  id            String                  @id @default(uuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String                  @default("New Concierge Thread")
  isArchived    Boolean                 @default(false)
  archivedAt    DateTime?
  isPinned      Boolean                 @default(false)
  pinnedAt      DateTime?
  lastMessageAt DateTime?
  deletedAt     DateTime?
  messages      AiMessage[]
  contexts      AiConversationContext[]
  events        AiAssistantEvent[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId, deletedAt, updatedAt])
  @@index([userId, lastMessageAt])
  @@index([userId, isArchived, isPinned, updatedAt])
}

model AiMessage {
  id             String          @id @default(uuid())
  conversationId String
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          AiMessageActor
  role           Role?
  content        String
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([conversationId, createdAt])
  @@index([actor, createdAt])
}

model AiConversationContext {
  id             String          @id @default(uuid())
  conversationId String
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userRole       Role
  pagePath       String?
  pageTitle      String?
  bookingId      String?
  leadId         String?
  projectId      String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
  @@index([bookingId, createdAt])
  @@index([leadId, createdAt])
  @@index([projectId, createdAt])
}

model AiPromptSuggestion {
  id          String    @id @default(uuid())
  role        Role?
  pageKey     String?
  title       String
  prompt      String
  description String?
  rank        Int       @default(0)
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role, pageKey, isActive, rank])
}

model AiAssistantEvent {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  role           Role
  eventType      String
  pageKey        String?
  section        String?
  intent         String?
  label          String?
  contentSnippet String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([role, eventType, createdAt])
  @@index([conversationId, createdAt])
}
